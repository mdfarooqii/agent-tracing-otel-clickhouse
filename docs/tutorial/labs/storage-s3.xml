<clickhouse>
    <!-- Module 11: tiered storage. New parts land on the local disk (volume
         "default"); TTL rules or a full local disk move them to S3 (volume "cold").
         Endpoint and credentials come from the environment, so the same file
         works for the local SeaweedFS lab and for real S3. -->
    <storage_configuration>
        <disks>
            <s3>
                <type>s3</type>
                <!-- Bucket URL plus a per-replica prefix: each replica keeps its own copy. -->
                <endpoint from_env="S3_ENDPOINT"/>
                <access_key_id from_env="S3_ACCESS_KEY_ID"/>
                <secret_access_key from_env="S3_SECRET_ACCESS_KEY"/>
                <region from_env="S3_REGION"/>
                <metadata_path>/var/lib/clickhouse/disks/s3/</metadata_path>
            </s3>
            <!-- Local read cache in front of S3, so repeated reads of cold data stay fast. -->
            <s3_cache>
                <type>cache</type>
                <disk>s3</disk>
                <path>/var/lib/clickhouse/disks/s3_cache/</path>
                <max_size>1Gi</max_size>
            </s3_cache>
        </disks>
        <policies>
            <tiered>
                <volumes>
                    <!-- The local volume must be named "default": an existing table can
                         only switch to a policy that keeps its old policy's volumes. -->
                    <default>
                        <disk>default</disk>
                    </default>
                    <cold>
                        <disk>s3_cache</disk>
                    </cold>
                </volumes>
                <!-- Also move the oldest parts to S3 when the local disk has less than 10% free. -->
                <move_factor>0.1</move_factor>
            </tiered>
        </policies>
    </storage_configuration>
</clickhouse>
